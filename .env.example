# Local defaults. Copy to .env: cp .env.example .env
POSTGRES_USER=app
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=app
HTTP_PORT=8080

# Starts the shared fakes from common/. Leave `fakes` out in production.
COMPOSE_PROFILES=fakes
PAYMENTS_WEBHOOK_URL=http://api:8080/api/webhooks/payments
PAYMENTS_WEBHOOK_SECRET=whsec_local_dev

# Production only (see compose.prod.yaml)
# SITE_ADDRESS=yourdomain.com
# IMAGE_REPO=owner/repo
# TAG=latest
